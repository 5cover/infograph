{
  "name": "infograph",
  "version": "1.0.0",
  "description": "Structure information, experiences and their relationships in a factual, human-writable, language-agnostic graph: the infograph.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./input": {
      "types": "./dist/input.d.ts",
      "import": "./dist/input.js"
    },
    "./model": {
      "types": "./dist/model.d.ts",
      "import": "./dist/model.js"
    },
    "./query": {
      "types": "./dist/query.d.ts",
      "import": "./dist/query.js"
    },
    "./graph": {
      "types": "./dist/graph.d.ts",
      "import": "./dist/graph.js"
    },
    "./edit": {
      "types": "./dist/edit.d.ts",
      "import": "./dist/edit.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "tsx --test test/**/*.test.ts",
    "build": "tsc -p tsconfig.build.json"
  },
  "keywords": [],
  "author": "5cover",
  "license": "ISC",
  "packageManager": "pnpm@12.18.0",
  "type": "module",
  "dependencies": {
    "@commander-js/extra-typings": "^15.0.0",
    "commander": "^15.1.0",
    "mermaid-ast": "^0.8.2",
    "ts-graphviz": "^3.0.13",
    "ts-markdown-builder": "^0.6.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "bin": "dist/cli.js",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "files": [
    "dist",
    "skills"
  ],
  "prettier": {
    "printWidth": 120,
    "tabWidth": 2,
    "singleQuote": true,
    "arrowParens": "avoid",
    "bracketSameLine": true,
    "semi": false,
    "endOfLine": "lf",
    "proseWrap": "never",
    "trailingComma": "es5",
    "overrides": [
      {
        "files": "**/*.ts",
        "options": {
          "parser": "typescript"
        }
      },
      {
        "files": [
          "**/*.ts",
          "**/*.tsx",
          "**/*.js",
          "**/*.jsx"
        ],
        "options": {
          "tabWidth": 4
        }
      }
    ]
  }
}
