              "description": "Lightweight labels. Supports simple search and grouping without adding many specialized fields.",
              "allOf": [
                {
                  "$ref": "#/definitions/__schema32"
                }
              ]
            },
            "actor": {
              "description": "Physical or organizational entities whose perspective, actions or constraints are materially represented by this node. Optional but encouraged.",
              "allOf": [
                {
                  "$ref": "#/definitions/__schema34"
                }
              ]
