          "$ref": "#/definitions/__schema1"
        },
        {
          "$ref": "#/definitions/__schema25"
        }
      ],
      "description": "Justification for selecting this value. Why choose this value and not another. Retraces author intent."
    },
    "__schema25": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/definitions/__schema1"
      }
    },
    "__schema26": {
      "anyOf": [
        {
          "$ref": "#/definitions/__schema27"
        },
        {
          "minItems": 1,
          "type": "array",
          "items": {
