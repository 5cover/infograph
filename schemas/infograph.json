{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "info": {
      "type": "object",
      "properties": {
        "title": {
          "$ref": "#/definitions/__schema0"
        },
        "context": {
          "$ref": "#/definitions/__schema1"
        },
        "author": {
          "$ref": "#/definitions/__schema2"
        }
      },
      "required": [
        "title",
        "context",
        "author"
      ],
      "additionalProperties": false,
      "description": "Infograph metadata."
    },
    "domain": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/definitions/__schema3"
        },
        "verb": {
          "$ref": "#/definitions/__schema6"
        },
        "source": {
          "$ref": "#/definitions/__schema8"
        }
      },
      "required": [
        "kind",
        "verb",
        "source"
      ],
      "additionalProperties": false,
      "description": "Definitions of the infograph's vocabulary."
    },
    "nodes": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/definitions/__schema10"
      },
      "additionalProperties": {
        "$ref": "#/definitions/__schema11"
      },
      "description": "Nodes of the graph. Keyed by node kind."
    },
    "edges": {
      "description": "Use for edges that don't belong to any particular node.",
      "allOf": [
        {
          "$ref": "#/definitions/__schema34"
        }
      ]
    }
  },
  "required": [
    "domain",
    "nodes"
  ],
  "additionalProperties": false,
  "definitions": {
    "__schema0": {
      "type": "string",
      "description": "Human-readable name for the whole graph."
    },
    "__schema1": {
      "type": "string",
      "description": "Short description of the real-world context represented by the graph. Gives global orientation without repeating the same context in every node."
    },
    "__schema2": {
      "type": "string",
      "description": "Person responsible for validating the graph. This graph is not just extracted text. It is a validated representation. The author field makes that explicit."
    },
    "__schema3": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/definitions/__schema4"
      },
      "additionalProperties": {
        "$ref": "#/definitions/__schema5"
      },
      "description": "Allowed node kinds."
    },
    "__schema4": {
      "type": "string",
      "pattern": "^[-_a-z]+$"
    },
    "__schema5": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "desc": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "__schema6": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/definitions/__schema7"
      },
      "additionalProperties": {
        "$ref": "#/definitions/__schema5"
      },
      "description": "What kinds of relationships exists. A verb may leave unanswered questions about the nature of the relationship, but not about the identity of additional participants."
    },
    "__schema7": {
      "type": "string",
      "pattern": "^(?!\\x77ith$|\\x69nfo$)[-_a-z]+$"
    },
    "__schema8": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/definitions/__schema9"
      },
      "additionalProperties": {
        "$ref": "#/definitions/__schema5"
      },
      "description": "Available materialized sources to verify the node's claims. Memory is not a source, it is a private buffer."
    },
    "__schema9": {
      "type": "string"
    },
    "__schema10": {
      "type": "string",
      "pattern": "^[-_a-z]+ [-_a-z]+$"
    },
    "__schema11": {
      "allOf": [
        {
          "$ref": "#/definitions/__schema12"
        },
        {
          "$ref": "#/definitions/__schema27"
        }
      ]
    },
    "__schema12": {
      "type": "object",
      "properties": {
        "info": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "description": "Short human label for the node. Makes the graph readable and editable by hand. This is not final artifact wording."
            },
            "summary": {
              "description": "Compact factual description of the node. Gives enough context to understand the node without following every edge. It should remain factual, not rhetorical.",
              "allOf": [
                {
                  "$ref": "#/definitions/__schema13"
                }
              ]
            },
            "fact": {
              "description": "Atomic factual claims attached to the node. Keeps facts separated from wording. The same statements can later support slides, reports or oral explanations.",
              "allOf": [
                {
                  "$ref": "#/definitions/__schema14"
                }
              ]
            },
            "date": {
              "description": "Approximate time range during which this node matters. Allows timeline-oriented queries without forcing every fact into prose. Approximate periods are acceptable for manual writing.",
              "allOf": [
                {
                  "$ref": "#/definitions/__schema16"
                }
              ]
            },
            "importance": {
              "description": "Importance of this node in the real experience. Not correlated to complexity or size. Left missing when unknown.",
              "allOf": [
                {
                  "$ref": "#/definitions/__schema17"
                }
              ]
            },
            "complexity": {
              "description": "Estimated explanation cost of this node. Note: this refers to explanation complexity, not node complexity. A node may refer to a very complex task and remain reasonably simple to explain.",
              "allOf": [
                {
                  "$ref": "#/definitions/__schema19"
                }
              ]
            },
            "source": {
              "description": "Where the information comes from. Source can be omitted for common / general knowledge information, like well-known public tools.",
              "allOf": [
                {
                  "$ref": "#/definitions/__schema22"
                }
              ]
            },
            "tag": {
              "description": "Lightweight labels. Supports simple search and grouping without adding many specialized fields.",
              "allOf": [
                {
                  "$ref": "#/definitions/__schema25"
                }
              ]
            }
          },
          "required": [
            "title"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "info"
      ],
      "additionalProperties": {}
    },
    "__schema13": {
      "type": "string"
    },
    "__schema14": {
      "anyOf": [
        {
          "$ref": "#/definitions/__schema15"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/definitions/__schema15"
          }
        }
      ]
    },
    "__schema15": {
      "type": "string"
    },
    "__schema16": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "from": {
              "type": "string"
            },
            "to": {
              "type": "string"
            }
          },
          "required": [
            "from",
            "to"
          ],
          "additionalProperties": false
        },
        {
          "type": "string"
        }
      ]
    },
    "__schema17": {
      "type": "object",
      "properties": {
        "is": {
          "type": "string",
          "enum": [
            "minor",
            "useful",
            "major",
            "central"
          ]
        },
        "why": {
          "anyOf": [
            {
              "$ref": "#/definitions/__schema18"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/definitions/__schema18"
              }
            }
          ]
        }
      },
      "required": [
        "is",
        "why"
      ],
      "additionalProperties": false
    },
    "__schema18": {
      "type": "string"
    },
    "__schema19": {
      "type": "object",
      "properties": {
        "is": {
          "$ref": "#/definitions/__schema20"
        },
        "why": {
          "anyOf": [
            {
              "$ref": "#/definitions/__schema21"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/definitions/__schema21"
              }
            }
          ]
        }
      },
      "required": [
        "is",
        "why"
      ],
      "additionalProperties": false
    },
    "__schema20": {
      "anyOf": [
        {
          "type": "string",
          "const": "simple",
          "description": "easy to mention"
        },
        {
          "type": "string",
          "const": "natural",
          "description": "needs explanation, but self-contained and natural to explain"
        },
        {
          "type": "string",
          "const": "contextual",
          "description": "needs context from other nodes not in the relation"
        },
        {
          "type": "string",
          "const": "intertwined",
          "description": "needs deep context or demonstration"
        }
      ]
    },
    "__schema21": {
      "type": "string"
    },
    "__schema22": {
      "anyOf": [
        {
          "$ref": "#/definitions/__schema23"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/definitions/__schema23"
          }
        }
      ]
    },
    "__schema23": {
      "type": "object",
      "properties": {
        "is": {
          "$ref": "#/definitions/__schema9"
        },
        "why": {
          "anyOf": [
            {
              "$ref": "#/definitions/__schema24"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/definitions/__schema24"
              }
            }
          ]
        }
      },
      "required": [
        "is",
        "why"
      ],
      "additionalProperties": false
    },
    "__schema24": {
      "type": "string"
    },
    "__schema25": {
      "anyOf": [
        {
          "$ref": "#/definitions/__schema26"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/definitions/__schema26"
          }
        }
      ]
    },
    "__schema26": {
      "type": "string"
    },
    "__schema27": {
      "type": "object",
      "patternProperties": {
        "^(?!\\x77ith$|\\x69nfo$)[-_a-z]+$": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/definitions/__schema10"
          },
          "additionalProperties": {
            "$ref": "#/definitions/__schema28"
          },
          "description": "Outgoing edges."
        }
      }
    },
    "__schema28": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/definitions/__schema29"
        },
        {
          "allOf": [
            {
              "$ref": "#/definitions/__schema29"
            },
            {
              "$ref": "#/definitions/__schema12"
            },
            {
              "allOf": [
                {
                  "$ref": "#/definitions/__schema27"
                }
              ]
            }
          ]
        }
      ]
    },
    "__schema29": {
      "type": "object",
      "properties": {
        "with": {
          "description": "Edge information.",
          "allOf": [
            {
              "$ref": "#/definitions/__schema30"
            }
          ]
        }
      },
      "additionalProperties": {}
    },
    "__schema30": {
      "type": "object",
      "properties": {
        "complexity": {
          "type": "object",
          "properties": {
            "is": {
              "$ref": "#/definitions/__schema20"
            },
            "why": {
              "anyOf": [
                {
                  "$ref": "#/definitions/__schema31"
                },
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/__schema31"
                  }
                }
              ]
            }
          },
          "required": [
            "is",
            "why"
          ],
          "additionalProperties": false
        },
        "fact": {
          "description": "Some relationships are harder to explain than the things they connect.",
          "allOf": [
            {
              "$ref": "#/definitions/__schema32"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "__schema31": {
      "type": "string"
    },
    "__schema32": {
      "anyOf": [
        {
          "$ref": "#/definitions/__schema33"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/definitions/__schema33"
          }
        }
      ]
    },
    "__schema33": {
      "type": "string"
    },
    "__schema34": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[-_a-z]+ [-_a-z]+ (?!\\x77ith$|\\x69nfo$)[-_a-z]+ [-_a-z]+ [-_a-z]+$"
      },
      "additionalProperties": {
        "$ref": "#/definitions/__schema30"
      }
    }
  }
}