  "definitions": {
    "__schema0": {
      "description": "Human-readable name for the whole graph.",
      "allOf": [
        {
          "$ref": "#/definitions/__schema1"
        }
      ]
    },
    "__schema1": {
      "type": "string",
      "minLength": 1,
      "description": "Information intentionally expressed in natural language rather than a structured value. Use it when meaning is better conveyed through human language than additional schema. Keep it factual, concise and independent from any specific presentation or wording."
    },
    "__schema2": {
      "description": "Short description of the real-world context represented by the graph. Gives global orientation without repeating the same context in every node.",
      "allOf": [
        {
          "$ref": "#/definitions/__schema1"
        }
      ]
    },
    "__schema3": {
      "description": "Person responsible for validating the graph. This graph is not just extracted text. It is a validated representation. The author field makes that explicit.",
      "allOf": [
        {
          "$ref": "#/definitions/__schema1"
        }
      ]
    },
    "__schema4": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/definitions/__schema5"
      },
      "additionalProperties": {
        "$ref": "#/definitions/__schema6"
      },
      "description": "Allowed node kinds."
    },
    "__schema5": {
      "type": "string",
      "pattern": "^(-|[a-z0-9]+(_[a-z0-9]+)*)$"
    },
    "__schema6": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "desc": {
              "description": "Description of this keyword's semantic and intended use.",
