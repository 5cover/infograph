      "allOf": [
        {
          "$ref": "#/definitions/__schema37"
        }
      ]
    },
    "__schema37": {
      "anyOf": [
        {
          "$ref": "#/definitions/__schema1"
        },
        {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/definitions/__schema1"
          }
        }
      ]
    },
    "__schema38": {
