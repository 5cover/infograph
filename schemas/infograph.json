          "description": "affirmation held to be true in the infographic, because observed or sufficiently supported by sources. It can include a reasonable inference, without imposing an additional distinction."
        },
        {
          "type": "object",
          "propertyNames": {
            "$ref": "#/definitions/__schema16"
          },
          "additionalProperties": {
            "$ref": "#/definitions/__schema1"
          },
          "required": [
            "hypothesis"
          ],
          "description": "possible explanation whose sources do not yet allow establishing the truth."
        },
        {
          "type": "object",
          "propertyNames": {
            "$ref": "#/definitions/__schema17"
          },
          "additionalProperties": {
            "$ref": "#/definitions/__schema1"
          },
          "required": [
            "opinion"
          ],
          "description": "judgment, appreciation, preference or position of the author. It is not intended to become true or false by accumulation of evidence."
        },
        {
          "type": "object",
          "propertyNames": {
            "$ref": "#/definitions/__schema18"
          },
          "additionalProperties": {
            "$ref": "#/definitions/__schema1"
          },
          "required": [
            "counterfactual"
          ],
          "description": "affirmation about what could have, should have, or might occur in a different situation."
        }
