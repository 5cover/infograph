          }
        }
      ]
    },
    "__schema27": {
      "type": "object",
      "properties": {
        "is": {
          "description": "Selected value.",
          "allOf": [
            {
              "$ref": "#/definitions/__schema5"
            }
          ]
        },
        "why": {
          "anyOf": [
            {
              "$ref": "#/definitions/__schema1"
            },
            {
              "$ref": "#/definitions/__schema28"
            }
          ],
          "description": "Justification for selecting this value. Why choose this value and not another. Retraces author intent."
        }
      },
      "required": ["is", "why"],
      "additionalProperties": false
    },
    "__schema28": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/definitions/__schema1"
      }
    },
    "__schema29": {
      "anyOf": [
        {
          "$ref": "#/definitions/__schema5"
        },
        {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/definitions/__schema5"
          }
        }
      ]
    },
    "__schema30": {
      "type": "object",
      "patternProperties": {
        "^(?!\\x77ith$|\\x69nfo$)(-|[a-z0-9]+(_[a-z0-9]+)*)$": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/definitions/__schema10"
          },
          "additionalProperties": {
            "$ref": "#/definitions/__schema31"
          },
          "description": "Outgoing edges."
        }
      }
    },
    "__schema31": {
      "anyOf": [
        {
          "allOf": [
            {
              "$ref": "#/definitions/__schema32"
            },
            {
              "$ref": "#/definitions/__schema12"
            },
            {
              "allOf": [
                {
                  "$ref": "#/definitions/__schema30"
                }
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/definitions/__schema32"
            }
          ]
        }
      ]
    },
    "__schema32": {
