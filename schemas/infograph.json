    "__schema12": {
      "type": "object",
      "properties": {
        "info": {
          "type": "object",
          "properties": {
            "title": {
              "description": "Short human label for the node.",
              "allOf": [
                {
                  "$ref": "#/definitions/__schema1"
                }
              ]
            },
            "summary": {
              "description": "Compact factual description of the node. Gives enough context to understand the node without following every edge. It should remain factual, not rhetorical.",
              "allOf": [
                {
                  "$ref": "#/definitions/__schema1"
                }
              ]
            },
            "claim": {
              "description": "Atomic claims attached to the node. The same statements can later support slides, reports or oral explanations.",
              "allOf": [
                {
                  "$ref": "#/definitions/__schema13"
                }
              ]
            },
            "date": {
              "description": "Time range during which this node matters. Allows timeline-oriented queries. Approximate periods are acceptable.",
              "allOf": [
                {
                  "$ref": "#/definitions/__schema19"
                }
              ]
            },
            "importance": {
              "description": "Importance of this node in the real experience. Not correlated to complexity or size. Left missing when unknown.",
              "allOf": [
                {
                  "$ref": "#/definitions/__schema21"
                }
              ]
            },
            "complexity": {
              "type": "object",
              "properties": {
                "is": {
                  "$ref": "#/definitions/__schema23"
                },
                "why": {
                  "$ref": "#/definitions/__schema29"
                }
              },
              "required": [
                "is",
                "why"
              ],
              "description": "Estimated explanation cost of this node. Note: this refers to explanation complexity, not node complexity. A node may refer to a very complex task and remain reasonably simple to explain.",
              "additionalProperties": false
            },
            "source": {
              "description": "Where the information comes from. Source can be omitted for common / general knowledge information, like well-known public tools.",
              "allOf": [
                {
                  "$ref": "#/definitions/__schema31"
                }
              ]
            },
            "tag": {
              "description": "Lowercase kebab-case labels intended for lightweight classification, not prose. Allow for simple search and grouping without adding many specialized fields.",
              "allOf": [
                {
                  "$ref": "#/definitions/__schema34"
                }
              ]
            }
          },
          "required": [
            "title",
            "complexity"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "info"
      ],
      "additionalProperties": {}
    },
    "__schema13": {
      "type": "array",
