{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "checkJs": false,
    "experimentalDecorators": false,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strict": true,
    "types": ["node"],
    "lib": ["ESNext"],
    "verbatimModuleSyntax": true,
    "incremental": true
  },
  "exclude": ["node_modules", "**/node_modules/*"]
}
